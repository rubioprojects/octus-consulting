# Public analytics / Search Console — leave empty until Rubio provides real IDs.
# Do not invent placeholder values. Site remains fully functional when unset.

# Google Tag Manager container (orchestration layer). Example format only: GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=

# GA4 measurement ID — loaded through GTM, not via direct gtag install. Example: G-XXXXXXXX
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Google Search Console HTML tag verification token (meta content value only).
# Do not use DNS changes from the application. Leave empty until Rubio supplies the token.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
